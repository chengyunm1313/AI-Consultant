<%
const menu = theme.menu || {};
function menuPath(labels, fallback) {
  for (let index = 0; index < labels.length; index += 1) {
    if (menu[labels[index]]) return menu[labels[index]];
  }
  return fallback;
}
const navGroups = [
  {
    label: '服務',
    links: [
      { label: '完整服務', path: menuPath(['完整服務', '服務項目'], '/service/') },
      { label: '合作洽詢', path: menuPath(['合作洽詢', '聯絡我'], '/contact/'), cta: true }
    ]
  },
  {
    label: '案例',
    links: [
      { label: '作品集', path: menuPath(['作品集'], '/works/') },
      { label: 'AI Agent', path: menuPath(['AI Agent'], '/ai-agent/') },
      { label: 'n8n 自動化', path: menuPath(['n8n 自動化'], '/n8n-automation/') }
    ]
  },
  {
    label: '知識',
    links: [
      { label: '部落格', path: menuPath(['部落格'], '/blog/') }
    ]
  },
  {
    label: '關於',
    links: [
      { label: '關於享哥', path: menuPath(['關於享哥'], '/collection/') }
    ]
  }
];
%>
<header class="site-header" data-site-header>
  <nav class="site-nav" aria-label="主要導覽">
    <div class="container">
      <div class="site-nav__bar">
        <a class="site-brand" href="<%- url_for('/') %>" aria-label="回到徐享 AI 工作流顧問首頁">
          <img class="site-brand__logo" src="<%= url_for('/images/site-v1/brand-lockup-v2-inverse.svg') %>" width="420" height="80" alt="徐享 AI WORKFLOW STUDIO">
        </a>
        <button class="site-nav__toggle navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#siteNavMenu" aria-controls="siteNavMenu" aria-expanded="false" aria-label="開啟導覽選單">
          <span class="site-nav__toggle-label">選單</span>
          <span class="material-symbols-outlined" aria-hidden="true">menu</span>
        </button>
      </div>

      <div class="collapse navbar-collapse" id="siteNavMenu">
        <div class="site-nav__groups">
          <% navGroups.forEach(function(group) { %>
            <div class="site-nav__group">
              <span class="site-nav__group-label"><%= group.label %></span>
              <div class="site-nav__group-links">
                <% group.links.forEach(function(item) { %>
                  <a
                    class="site-nav__link<%= item.cta ? ' site-nav__link--cta' : '' %><%= is_current(item.path) ? ' is-active' : '' %>"
                    href="<%- url_for(item.path) %>"
                    <% if (is_current(item.path)) { %>aria-current="page"<% } %>
                    <% if (item.cta) { %>data-track-event="contact_page_click" data-track-placement="navigation"<% } %>
                  >
                    <span><%= item.label %></span>
                    <% if (item.cta) { %><span class="material-symbols-outlined" aria-hidden="true">arrow_outward</span><% } %>
                  </a>
                <% }) %>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    </div>
  </nav>
</header>
