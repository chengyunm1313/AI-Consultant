<%
const businessAeo = site.data.aeo && site.data.aeo.business ? site.data.aeo.business : {};
const socialLinks = businessAeo.same_as || [];
const businessEmail = businessAeo.email || 'seanhsu1313@gmail.com';
const lineUrl = socialLinks[3] || 'https://lin.ee/epeTR8o';
const businessAddress = businessAeo.address || {};
%>
<footer class="site-footer">
  <div class="container">
    <div class="site-footer__grid">
      <div class="site-footer__identity">
        <a class="site-brand site-brand--inverse mb-4" href="<%- url_for('/') %>" aria-label="回到徐享 AI 工作流顧問首頁">
          <img class="site-brand__logo" src="<%= url_for('/images/site-v1/brand-lockup-v2.svg') %>" width="420" height="80" alt="徐享 AI WORKFLOW STUDIO">
        </a>
        <p class="mb-0">把目前卡住的流程帶來，從問題盤點開始，一起整理成能執行的下一步。</p>
      </div>
      <div class="site-footer__action">
        <p class="site-footer__kicker mb-3">START WITH THE PROBLEM</p>
        <h2 class="mb-4">準備好把流程整理好了嗎？</h2>
        <a class="site-button site-button--signal" href="<%= lineUrl %>" target="_blank" rel="noopener noreferrer" data-track-event="contact_cta_click" data-track-method="line" data-track-placement="footer">
          LINE 先聊聊
          <span class="material-symbols-outlined" aria-hidden="true">arrow_outward</span>
        </a>
      </div>
    </div>
    <div class="site-footer__meta">
      <address>
        <strong><%= businessAeo.name || '徐享｜AI 應用規劃師' %></strong>
        <span>Email：<a href="mailto:<%= businessEmail %>" data-track-event="contact_cta_click" data-track-method="email" data-track-placement="footer"><%= businessEmail %></a></span>
        <span><%= businessAddress.street || '新北市中和捷運站步行五分鐘' %></span>
      </address>
      <div class="site-footer__socials" aria-label="社群連結">
        <a href="<%= socialLinks[0] || 'https://www.instagram.com/skypassion2013/' %>" target="_blank" rel="noopener noreferrer">Instagram</a>
        <a href="<%= socialLinks[1] || 'https://www.facebook.com/HsiangPMKT?locale=zh_TW' %>" target="_blank" rel="noopener noreferrer">Facebook</a>
        <a href="<%= socialLinks[2] || 'https://www.youtube.com/channel/UC8f4hKwj7P4ca_lcaDFoxiQ' %>" target="_blank" rel="noopener noreferrer">YouTube</a>
      </div>
    </div>
  </div>
</footer>
