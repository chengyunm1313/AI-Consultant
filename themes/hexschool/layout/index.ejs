<%
const homeAeo = site.data.aeo && site.data.aeo.pages ? site.data.aeo.pages.home || {} : {};
const businessAeo = site.data.aeo && site.data.aeo.business ? site.data.aeo.business || {} : {};
const homeFaq = Array.isArray(homeAeo.faq) ? homeAeo.faq : [];
const socialLinks = Array.isArray(businessAeo.same_as) ? businessAeo.same_as : [];
const serviceCatalog = Array.isArray(businessAeo.service_catalog) ? businessAeo.service_catalog : [];
const serviceNames = Array.isArray(homeAeo.service_cards) && homeAeo.service_cards.length
  ? homeAeo.service_cards
  : ['AI 應用規劃', 'n8n 自動化工作', '電商社群行銷', 'AI 轉型顧問諮詢'];
const serviceItems = serviceNames.map(function(name, index) {
  const catalog = serviceCatalog[index] || {};
  return {
    number: String(index + 1).padStart(2, '0'),
    name: name,
    description: catalog.description || '從目標與現況出發，整理一套能真正落地的做法。'
  };
});
const works = Array.isArray(site.data.works) ? site.data.works : [];
const featuredWorks = works.filter(function(work) { return work.featured !== false; }).slice(0, 3);
const workflowSteps = [
  { number: '01', title: '把問題說清楚', description: '先把產業、目標與目前卡住的工作整理出來。' },
  { number: '02', title: '找到值得改善的環節', description: '分辨哪些工作適合 AI、哪些流程值得自動化。' },
  { number: '03', title: '做出可討論的方案', description: '把工具、流程與執行範圍變成看得見的藍圖。' },
  { number: '04', title: '交付可以使用的成果', description: '用實作、追蹤與調整，讓團隊真的用得起來。' }
];
const problemItems = [
  { number: '01', title: '想導入 AI，卻不知道先從哪個流程開始' },
  { number: '02', title: '每天花很多時間整理資料與回覆訊息' },
  { number: '03', title: '內容、電商與社群行銷一直做不完' },
  { number: '04', title: '想安排企業內訓或客製工作坊' }
];

function localUrl(value) {
  if (!value) return '';
  return /^https?:\/\//.test(String(value)) ? value : url_for(value);
}
%>
<main id="main-content" class="site-home">
  <section class="sv1-hero">
    <div class="container">
      <div class="sv1-hero__grid">
        <div class="sv1-hero__copy" data-reveal>
          <p class="sv1-kicker mb-4">AI WORKFLOW STUDIO <span>／ 享哥</span></p>
          <h1 class="sv1-hero__title mb-4">把混亂的 AI 需求<br><span>整理成可執行流程。</span></h1>
          <p class="sv1-hero__lead mb-4">
            <%= homeAeo.hero_intro || '專精 AI 應用規劃、AI Agent 與 Codex 工作流、n8n 自動化及中小企業數位轉型顧問。' %>
          </p>
          <div class="d-flex flex-wrap gap-3 mb-5">
            <a class="site-button site-button--dark" href="<%= url_for('/contact/') %>" data-track-event="contact_page_click" data-track-placement="home_hero">
              先聊聊目前的問題
              <span class="material-symbols-outlined" aria-hidden="true">arrow_outward</span>
            </a>
            <a class="site-button site-button--outline" href="<%= url_for('/works/') %>">
              看實作案例
              <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
            </a>
          </div>
          <div class="sv1-proof-line" aria-label="徐享專業摘要">
            <div><strong>10+</strong><span>年數位行銷與電商實戰</span></div>
            <div><strong>AI</strong><span>規劃、Agent、n8n 與內容流程</span></div>
          </div>
        </div>
        <div class="sv1-hero__visual" data-reveal data-delay="1">
          <div class="sv1-hero__grid-lines" aria-hidden="true"></div>
          <img
            src="<%= url_for('/images/site-v1/assets/workbench-hero.png') %>"
            srcset="<%= url_for('/images/site-v1/assets/workbench-hero-960.png') %> 960w, <%= url_for('/images/site-v1/assets/workbench-hero.png') %> 1672w"
            sizes="(max-width: 767px) 100vw, 58vw"
            width="1672"
            height="941"
            alt="以紙卡、流程線與黃綠標記整理企業需求的工作台"
            fetchpriority="high"
          >
          <span class="sv1-hero__stamp">FROM PROBLEM<br>TO PROCESS</span>
          <span class="sv1-hero__caption">診斷工作台 / 01</span>
        </div>
      </div>
    </div>
  </section>

  <section class="sv1-section sv1-section--problems">
    <div class="container">
      <div class="sv1-section-head" data-reveal>
        <div>
          <p class="sv1-kicker">START WITH THE REAL PROBLEM</p>
          <h2>不用先講懂工具，<br><span>先說你卡在哪裡。</span></h2>
        </div>
        <p>好的 AI 導入不是把工具全部買回來，而是先找到最值得被整理的那一段工作。</p>
      </div>
      <div class="sv1-problem-grid">
        <% problemItems.forEach(function(item, index) { %>
          <article class="sv1-problem" data-reveal data-delay="<%= index %>">
            <span class="sv1-number"><%= item.number %></span>
            <h3><%= item.title %></h3>
          </article>
        <% }) %>
      </div>
    </div>
  </section>

  <section id="workflow" class="sv1-section sv1-section--ink sv1-workflow">
    <div class="container">
      <div class="sv1-section-head sv1-section-head--light" data-reveal>
        <div>
          <p class="sv1-kicker sv1-kicker--light">THE WORKFLOW</p>
          <h2>從一團亂，<br><span>走到下一步。</span></h2>
        </div>
        <p>把問題拆成可判斷的節點，再用適合的工具和執行方式，做出可以被團隊接住的成果。</p>
      </div>
      <div class="sv1-workflow__layout">
        <div class="sv1-workflow__visual" data-reveal>
          <img
            src="<%= url_for('/images/site-v1/assets/workbench-services.png') %>"
            srcset="<%= url_for('/images/site-v1/assets/workbench-services-720.png') %> 720w, <%= url_for('/images/site-v1/assets/workbench-services.png') %> 1448w"
            sizes="(max-width: 767px) 100vw, 42vw"
            width="1448"
            height="1086"
            loading="lazy"
            alt="四張流程卡與連接線組成的工作流程示意"
          >
          <span class="sv1-workflow__label">WORKBENCH / 04 STEPS</span>
        </div>
        <ol class="sv1-workflow__list" data-workflow>
          <% workflowSteps.forEach(function(step, index) { %>
            <li class="sv1-workflow__step" data-workflow-step data-reveal data-delay="<%= index %>">
              <span class="sv1-number"><%= step.number %></span>
              <div>
                <h3><%= step.title %></h3>
                <p><%= step.description %></p>
              </div>
            </li>
          <% }) %>
        </ol>
      </div>
    </div>
  </section>

  <section id="featured-work" class="sv1-section sv1-section--cases">
    <div class="container">
      <div class="sv1-section-head" data-reveal>
        <div>
          <p class="sv1-kicker">SELECTED CASES</p>
          <h2>先看成果，<br><span>再談方法。</span></h2>
        </div>
        <a class="sv1-text-link" href="<%= url_for('/works/') %>">瀏覽全部案例 <span aria-hidden="true">↗</span></a>
      </div>
      <div class="sv1-case-grid">
        <% featuredWorks.forEach(function(work, index) { %>
          <article class="sv1-case-card<%= index === 0 ? ' sv1-case-card--featured' : '' %>" data-reveal data-delay="<%= index %>">
            <a class="sv1-case-card__media" href="<%= localUrl(work.article_url || work.primary_url) %>">
              <img
                src="<%= localUrl(work.cover || '/images/site-v1/assets/workbench-case.png') %>"
                alt="<%= work.title %>"
                loading="lazy"
              >
              <span class="sv1-case-card__arrow" aria-hidden="true">↗</span>
            </a>
            <div class="sv1-case-card__body">
              <div class="sv1-case-card__meta"><span>0<%= index + 1 %></span><span><%= work.category === 'n8n' ? 'n8n AUTOMATION' : 'VIBE CODING' %></span></div>
              <h3><a href="<%= localUrl(work.article_url || work.primary_url) %>"><%= work.title %></a></h3>
              <p><%= work.summary %></p>
              <div class="sv1-chip-row">
                <% (work.stack || []).slice(0, 3).forEach(function(item) { %>
                  <span class="sv1-chip"><%= item %></span>
                <% }) %>
              </div>
            </div>
          </article>
        <% }) %>
      </div>
    </div>
  </section>

  <section class="sv1-section sv1-section--services">
    <div class="container">
      <div class="sv1-services__layout">
        <div class="sv1-services__intro" data-reveal>
          <p class="sv1-kicker">WHAT I CAN HELP WITH</p>
          <h2>把工具放回<br><span>工作的脈絡裡。</span></h2>
          <p>不從工具清單出發，而是從你的目標、資源與團隊習慣出發，找到適合的切入點。</p>
          <a class="sv1-text-link" href="<%= url_for('/service/') %>">查看完整服務 <span aria-hidden="true">↗</span></a>
        </div>
        <div class="sv1-services__visual" data-reveal data-delay="1">
          <img
            src="<%= url_for('/images/site-v1/assets/workbench-case.png') %>"
            srcset="<%= url_for('/images/site-v1/assets/workbench-case-720.png') %> 720w, <%= url_for('/images/site-v1/assets/workbench-case.png') %> 1536w"
            sizes="(max-width: 767px) 100vw, 38vw"
            width="1536"
            height="1024"
            loading="lazy"
            alt="案例證據卡、透明紙張與黃綠流程標記"
          >
        </div>
        <ol class="sv1-service-list">
          <% serviceItems.forEach(function(item, index) { %>
            <li data-reveal data-delay="<%= index %>">
              <span class="sv1-number"><%= item.number %></span>
              <div><h3><%= item.name %></h3><p><%= item.description %></p></div>
              <a href="<%= url_for('/service/') %>" aria-label="了解<%= item.name %>">↗</a>
            </li>
          <% }) %>
        </ol>
      </div>
    </div>
  </section>

  <section class="sv1-section sv1-section--faq">
    <div class="container sv1-faq__layout">
      <div data-reveal>
        <p class="sv1-kicker">QUESTIONS BEFORE ACTION</p>
        <h2>先把疑問<br><span>整理清楚。</span></h2>
      </div>
      <div class="sv1-faq-list">
        <% homeFaq.forEach(function(item, index) { %>
          <details class="sv1-faq-item"<%= index === 0 ? ' open' : '' %> data-reveal data-delay="<%= index %>">
            <summary><span><%= item.question %></span><b aria-hidden="true">+</b></summary>
            <p><%= item.answer %></p>
          </details>
        <% }) %>
      </div>
    </div>
  </section>

  <section class="sv1-section sv1-section--articles">
    <div class="container">
      <div class="sv1-section-head" data-reveal>
        <div>
          <p class="sv1-kicker">FIELD NOTES</p>
          <h2>把實作過程<br><span>寫給你看。</span></h2>
        </div>
        <a class="sv1-text-link" href="<%= url_for('/blog/') %>">前往部落格 <span aria-hidden="true">↗</span></a>
      </div>
      <div class="sv1-article-grid">
        <% page.posts.slice(0, 3).each(function(post, index) { %>
          <article class="sv1-article-card" data-reveal data-delay="<%= index %>">
            <a class="sv1-article-card__media" href="<%= url_for(post.path) %>">
              <img src="<%= url_for(post.cover || '/images/default-cover.png') %>" alt="<%= post.title %>" loading="lazy">
            </a>
            <div class="sv1-article-card__body">
              <p class="sv1-article-card__date"><%= date(post.date, 'YYYY.MM.DD') %></p>
              <h3><a href="<%= url_for(post.path) %>"><%= post.title %></a></h3>
              <a class="sv1-text-link" href="<%= url_for(post.path) %>">閱讀文章 <span aria-hidden="true">↗</span></a>
            </div>
          </article>
        <% }) %>
      </div>
    </div>
  </section>

  <section class="sv1-final-cta">
    <div class="container sv1-final-cta__grid">
      <div data-reveal>
        <p class="sv1-kicker sv1-kicker--light">READY TO SORT IT OUT?</p>
        <h2>把目前卡住的流程帶來，<br><span>我們從第一張卡開始。</span></h2>
        <p>不用先準備完整提案，先說明產業、現況與想改善的結果即可。</p>
        <a class="site-button site-button--signal" href="<%= url_for('/contact/') %>" data-track-event="contact_page_click" data-track-placement="home_final_cta">
          前往合作洽詢
          <span class="material-symbols-outlined" aria-hidden="true">arrow_outward</span>
        </a>
      </div>
      <div class="sv1-final-cta__visual" data-reveal data-delay="1">
        <img
          src="<%= url_for('/images/site-v1/assets/workbench-contact.png') %>"
          srcset="<%= url_for('/images/site-v1/assets/workbench-contact-720.png') %> 720w, <%= url_for('/images/site-v1/assets/workbench-contact.png') %> 1122w"
          sizes="(max-width: 767px) 100vw, 34vw"
          width="1122"
          height="1402"
          loading="lazy"
          alt="手將黃綠標記放到整理完成的流程卡上"
        >
      </div>
    </div>
  </section>
</main>
