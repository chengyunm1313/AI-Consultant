{
  "name": "hexo-site",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": "24.x",
    "npm": ">=10"
  },
  "scripts": {
    "build": "hexo generate && node toWebp",
    "clean": "hexo clean",
    "deploy": "hexo clean && hexo generate && node toWebp && hexo deploy",
    "server": "hexo server",
    "verify:post-dates": "node tools/validate-post-dates.js",
    "verify:post-metadata": "node tools/validate-post-metadata.js",
    "verify:build-output": "node tools/validate-build-output.js",
    "verify:workflow-actions": "node tools/validate-workflow-actions.js",
    "verify:jsonld": "node tools/validate-jsonld.js",
    "verify:jsonld:local": "node tools/validate-jsonld.js --mode=local"
  },
  "hexo": {
    "version": "7.3.0"
  },
  "dependencies": {
    "bootstrap": "^5.3.3",
    "hexo": "^7.0.0",
    "hexo-deployer-git": "^4.0.0",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-category": "^2.0.0",
    "hexo-generator-index": "^3.0.0",
    "hexo-generator-sitemap": "^3.0.1",
    "hexo-generator-tag": "^2.0.0",
    "hexo-pagination": "^3.0.0",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-renderer-marked": "^6.0.0",
    "hexo-renderer-stylus": "^3.0.1",
    "hexo-server": "^3.0.0",
    "hexo-theme-landscape": "^1.0.0",
    "hexo-util": "^3.3.0",
    "sharp": "^0.34.2"
  }
}
